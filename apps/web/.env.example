# Public URL, used for share links, Open Graph images and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret used to sign run tokens (any long random string). Required in production.
RUN_TOKEN_SECRET=

# Supabase. Leave empty to use the local JSON file store (apps/web/.data/db.json) during development.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
