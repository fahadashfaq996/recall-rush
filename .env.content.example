# Copy to .env.content (git-ignored) to generate content packs with an LLM. Any OpenAI-compatible API works.
#
# Recommended (picked by a head-to-head on this game's content, Oct 2026): DeepSeek writes, Qwen fact-checks.
# A different model family for the fact-check catches more mistakes. A full batch costs about $0.25.
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=deepseek/deepseek-v4.1-flash-1017
AI_VERIFY_MODEL=qwen/qwen3.7-plus

# Direct DeepSeek API instead of OpenRouter (check their docs for current model names):
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
